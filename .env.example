# Snipe-IT lab environment — copy to .env and fill in real values.
# NEVER commit the real .env (see .gitignore).

# Generate with: docker run --rm snipe/snipe-it php artisan key:generate --show
# Paste the full output (starts with "base64:") here. Placeholder below is NOT valid.
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY

APP_URL=http://localhost:8080
APP_ENV=production
APP_DEBUG=false

# Database (must match between the app and MariaDB services)
DB_DATABASE=snipeit
DB_USERNAME=snipeit
DB_PASSWORD=changeme-db-password
MYSQL_ROOT_PASSWORD=changeme-root-password

# Mail (optional — leave blank to run the lab without outbound email)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDR=
MAIL_FROM_NAME=Snipe-IT Lab
